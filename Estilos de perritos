/* CARDS DE PERRITOS */

.container_image{
    width: 260px;
    height: 520px;
    padding: 10px;
    background-color: #c8d5b9;
    border: 5px solid #68b0ab;
    border-radius: 20px;
    text-align: center;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 
    'Open Sans', 'Helvetica Neue', sans-serif;
    margin: 20px auto;
}


.perritos{
    width: 100%;
    height: 306px;
    border-radius: 12px;
    display: block;
    margin-bottom: 12px;
    object-fit: cover;
    
}

/* --- EFECTO HOVER PARA LAS CARDS DE LOS PERRITOS --- */

/* 1. Modificamos el contenedor base para preparar la animación */
.container_image {
    transition: transform 0.3s ease, box-shadow 0.3s ease; /* Hace que la transición de agrandado sea suave */
    overflow: hidden; /* La imagen no sale de la Card */
    cursor: pointer; /* Cambia el cursor*/
}

/* 2. Al pasar el cursor sobre la card */
.container_image:hover {
    transform: scale(1.04); /* Agranda la tarjeta*/
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15); /* Le da profundidad simulando que se "eleva" */
}

/* 3. Preparamos la imagen dentro de la card para su propia animación */
.container_image .perritos {
    transition: transform 0.3s ease; /* Transición suave para la imagen */
}

/* 4. Cuando pasamos el cursor sobre la CARD, la IMAGEN interna también hace zoom */
.container_image:hover .perritos {
    transform: scale(1.06); /* Hace un ligero zoom a la foto del perrito */
}


/* ------------------------ */

/* Por defecto, la segunda foto está oculta */
.container_image .perritos_foto-hover {
    display: none;
}

/* Cuando pasamos el cursor por la CARD, ocultamos la primera foto... */
.container_image:hover .perritos {

    display: none;
}

/* ... y mostramos la segunda foto */
.container_image:hover .perritos_foto-hover {
    display: block;
    height: 306px;
    width: 100%;
}
